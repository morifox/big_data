# UID пользователя Airflow внутри контейнеров (для Windows оставить 50000)
AIRFLOW_UID=50000

# Вход в веб-интерфейс Airflow
AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow

# База данных с данными и витринами
STUDENTS_DB_NAME=students_db
STUDENTS_DB_USER=student
STUDENTS_DB_PASSWORD=student
STUDENTS_DB_PORT=5435
